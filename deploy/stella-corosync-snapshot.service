[Unit]
Description=Publish read-only Corosync membership for desktop telemetry
After=corosync.service

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/stella-corosync/corosync.py --write-snapshot /run/stella-corosync/status.json
RuntimeDirectory=stella-corosync
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/stella-corosync

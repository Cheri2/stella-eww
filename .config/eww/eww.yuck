;; ============================================================
;; Telemetry source
;; ============================================================

(deflisten telemetry
  :initial "{\"network\":{},\"nvidia\":{},\"ceph\":{},\"system\":{},\"routing\":{},\"zfs\":{\"text\":\"LOADING\"},\"nvmeof\":{\"text\":\"LOADING\"}}"
  `~/.local/bin/eww.py`)


(include "widgets.yuck")

;; ============================================================
;; Windows
;; ============================================================

(defwindow telemetry-window
  :monitor 0

  :geometry
    (geometry
      :x "30px"
      :y "70px"
      :width "380px"
      :anchor "top right")

  :stacking "bottom"
  :exclusive false
  :focusable false

  (telemetry-widget))


(defwindow system-window
  :monitor 0

  :geometry
    (geometry
      :x "442px"
      :y "70px"
      :width "320px"
      :anchor "top right")

  :stacking "bottom"
  :exclusive false
  :focusable false

  (system-routing-widget))
